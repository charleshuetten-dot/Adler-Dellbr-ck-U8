+    const offenAmAnfang = koepfe.filter(b => b.getAttribute("aria-expanded") === "true").length;
+
+    // ── Nur eines offen ─────────────────────────────────────────────────────
+    wissenAuf("kifu-spielformen"); await warte(80);

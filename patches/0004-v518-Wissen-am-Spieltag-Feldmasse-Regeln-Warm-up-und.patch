+    +((typeof skzLegende==="function")?skzLegende():"");
+}
+
+/* ─────────────────────────────────────────────────────────────────────────
+   Ansicht
+   ───────────────────────────────────────────────────────────────────────── */
+let _wsOffen=null;
+
+function wissenKachel(){
+  return '<button type="button" id="wissen-kachel" onclick="wissenOpen()" '
